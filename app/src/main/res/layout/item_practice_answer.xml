<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAnswer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_practice_answer">

    <TextView
        android:id="@+id/tvAnswerLabel"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="@string/item_practice_answer_number"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="VisualLintSystemUi" />

    <TextView
        android:id="@+id/tvAnswerContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:includeFontPadding="true"
        android:breakStrategy="simple"
        android:text="@string/item_practice_answer_content"
        android:textSize="16sp"
        tools:ignore="VisualLintSystemUi" />

</LinearLayout>