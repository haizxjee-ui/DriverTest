<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startupFragment">

    <fragment
        android:id="@+id/startupFragment"
        android:name="com.example.drivertest.ui.startup.StartupFragment"
        android:label="StartupFragment"
        tools:layout="@layout/fragment_startup_error">

        <action
            android:id="@+id/action_startupFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_startupFragment_to_licenseSelectionFragment"
            app:destination="@id/licenseSelectionFragment" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.drivertest.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_licenseSelectionFragment"
            app:destination="@id/licenseSelectionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_practiceFragment"
            app:destination="@id/practiceFragment" />
        <action
            android:id="@+id/action_homeFragment_to_wrongQuestionFragment"
            app:destination="@id/wrongQuestionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_mockExamFragment"
            app:destination="@id/mockExamFragment" />
        <action
            android:id="@+id/action_homeFragment_to_examResultFragment"
            app:destination="@id/examResultFragment" />

    </fragment>

    <fragment
        android:id="@+id/licenseSelectionFragment"
        android:name="com.example.drivertest.ui.license_selection.LicenseSelectionFragment"
        android:label="LicenseSelectionFragment"
        tools:layout="@layout/fragment_license_selection">

        <action
            android:id="@+id/action_licenseSelectionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>
    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.example.drivertest.ui.practice.practice_list_chapter.PracticeFragment"
        android:label="PracticeFragment"
        tools:layout="@layout/fragment_practice">

        <action
            android:id="@+id/action_practiceFragment_to_practiceQuestionFragment"
            app:destination="@id/practiceQuestionFragment" />

    </fragment>

    <fragment
        android:id="@+id/practiceQuestionFragment"
        android:name="com.example.drivertest.ui.practice.practice_question.PracticeQuestionFragment"
        android:label="PracticeQuestionFragment"
        tools:layout="@layout/fragment_practice_question">

        <argument
            android:name="chapterNumber"
            app:argType="integer" />

        <argument
            android:name="questionTypeID"
            app:argType="integer" />

    </fragment>
    <fragment
        android:id="@+id/wrongQuestionFragment"
        android:name="com.example.drivertest.ui.practice.practice_wrong_question.WrongQuestionFragment"
        android:label="fragment_wrong_question"
        tools:layout="@layout/fragment_wrong_question" />
    <fragment
        android:id="@+id/mockExamFragment"
        android:name="com.example.drivertest.ui.mock_exam.MockExamFragment"
        android:label="fragment_mock_exam"
        tools:layout="@layout/fragment_mock_exam" >
        <action
            android:id="@+id/action_mockExamFragment_to_mockExamTakingFragment"
            app:destination="@id/mockExamTakingFragment" />
    </fragment>
    <fragment
        android:id="@+id/mockExamTakingFragment"
        android:name="com.example.drivertest.ui.mock_exam.MockExamTakingFragment"
        android:label="MockExamTakingFragment"
        tools:layout="@layout/fragment_mock_exam_taking">
        <action
            android:id="@+id/action_mockExamTakingFragment_to_examResultFragment"
            app:destination="@id/examResultFragment" />
    </fragment>
    <fragment
        android:id="@+id/examResultFragment"
        android:name="com.example.drivertest.ui.mock_exam.ExamResultFragment"
        android:label="fragment_exam_result"
        tools:layout="@layout/fragment_exam_result" >

        <argument
            android:name="examID"
            app:argType="integer" />

        <argument
            android:name="examNumber"
            app:argType="integer" />

    </fragment>

</navigation>